# Copy to mobile/.env and edit. Never commit the real file.
#
# Only EXPO_PUBLIC_-prefixed vars are inlined into the client bundle, which
# also means anything here ships to the device in plaintext. No secrets.

# Simulator and web both reach the host machine on loopback.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# A physical device (Expo Go over the LAN) cannot see loopback -- that resolves
# to the phone itself. Use your computer's LAN address instead:
#
#   ipconfig getifaddr en0
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:8000
#
# The backend then has to be reachable from off-host too, which means starting
# it on 0.0.0.0 and letting that address through:
#
#   python manage.py runserver 0.0.0.0:8000
#   DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.42   (in backend/.env)
