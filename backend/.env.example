# Copy to backend/.env and edit. Never commit the real file.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Falls back to a hardcoded insecure key when unset, which is fine for local dev
# and must not be relied on anywhere else.
DJANGO_SECRET_KEY=

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Only consulted when DJANGO_DEBUG=False. With DEBUG on, all origins are allowed
# so the Expo client can reach the API from a phone on the LAN.
CORS_ALLOWED_ORIGINS=

# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
